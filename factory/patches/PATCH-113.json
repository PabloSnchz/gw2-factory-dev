     "op": "replace",
     "anchor": "    /* ============ ACTIVITIES ============ */\n    #activitiesPanel .card {\n      background:var(--gw-card-bg); border-radius:10px; padding:10px;\n      box-shadow:inset 0 0 0 1px var(--bd-1);\n    }\n    #activitiesPanel .muted { color:var(--gw-muted); }\n    #activitiesPanel .btn[disabled] { opacity:.5; cursor:not-allowed; }\n    #activitiesPanel .panel-head__title img { margin-right:6px; border-radius:4px; }\n    #activitiesPanel .node-icon { background:var(--bg-2); }\n\n    /* ============ HOME NODES ============ */\n    #homeNodesGrid .gw-node-ico {\n      width:22px; height:22px; border-radius:4px;\n      display:inline-flex; align-items:center; justify-content:center;\n      background:linear-gradient(180deg,var(--bg-2),var(--bg-0));\n      box-shadow:0 0 0 1px rgba(46,68,97,.55) inset,0 0 10px rgba(30,55,88,.38);\n      overflow:hidden;\n    }\n    :root {\n      --gw-mining-bg:linear-gradient(180deg,#1c2432,#0d1622);\n      --gw-logging-bg:linear-gradient(180deg,#1e2a21,#0f1a13);\n      --gw-harvest-bg:linear-gradient(180deg,#1c2230,#111827);\n    }\n    #homeNodesGrid .gw-node--mining .gw-node-ico {\n      background:var(--gw-mining-bg);\n      box-shadow:0 0 0 1px rgba(70,120,180,.6) inset, 0 0 10px rgba(70,120,180,.35);\n    }\n    #homeNodesGrid .gw-node--logging .gw-node-ico {\n      background:var(--gw-logging-bg);\n      box-shadow:0 0 0 1px rgba(84,124,90,.6) inset, 0 0 10px rgba(72,112,86,.35);\n    }\n    #homeNodesGrid .gw-node--harvest .gw-node-ico {\n      background:var(--gw-harvest-bg);\n      box-shadow:0 0 0 1px rgba(90,84,160,.6) inset, 0 0 10px rgba(90,84,160,.35);\n    }\n    #homeNodesGrid .gw-node-ico > img { width:22px; height:22px; display:block; }\n    #homeNodesGrid .gw-node-ico[data-fallback] {\n      font-size:13px; font-weight:700; color:var(--acc-2); line-height:1;\n    }\n    #homeNodesGrid .gw-node--logging .gw-node-ico[data-fallback] { color:var(--color-green); }\n    #homeNodesGrid .gw-node--harvest .gw-node-ico[data-fallback] { color:var(--acc-2); }\n",
