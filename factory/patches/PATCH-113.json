    },
    {
     "op": "replace",
     "anchor": "  <!-- Actividades -->\n  <script defer src=\"js/activities.js?v=3.23.0\"></script>\n  <script defer src=\"js/activities-theme.js?v=2.6.1\"></script>\n  <script defer src=\"js/fractal-tracker-theme.js?v=1.0.1\"></script>\n",
     "text": "  <!-- Actividades: js/act-*.js por js/modules.json (BL-070 ACT-7) -->\n"
    },
    {
     "op": "replace",
     "anchor": "\n<script>\n(function(){\n  function detectNodeType(nodeId){\n    nodeId = String(nodeId||'').toLowerCase();\n    if (/_ore_node$/.test(nodeId) || /_(crystal|obsidian|prismaticite|mursaat|brandstone|mistonium|difluorite)/.test(nodeId)) return 'mining';\n    if (/_wood_node$/.test(nodeId) || /petrified_stump|lowland_pine/.test(nodeId)) return 'logging';\n    return 'harvest';\n  }\n\n  const HOME_NODE_ITEM_MAP = {\n    'orichalcum_ore_node': 19701,\n    'mithril_ore_node':    19700,\n    'ancient_wood_node':   19725,\n    'quartz_node':         43773,\n    'flaxseed_node':       74090,\n    'omnomberry_node':     12128\n  };\n\n  async function fetchItemIcons(ids=[]){\n    if (!ids.length) return {};\n    const url = `https://api.guildwars2.com/v2/items?ids=${ids.join(',')}`;\n    const res = await fetch(url, { mode:'cors' });\n    if (!res.ok) return {};\n    const arr = await res.json();\n    const out = {};\n    arr.forEach(it => { if (it && it.id && it.icon) out[it.id] = { name: it.name, icon: it.icon }; });\n    return out;\n  }\n\n  async function applyHomeNodePresets(container){\n    const cards = Array.from(container.querySelectorAll('label.card[data-node-id]'));\n    if (!cards.length) return;\n\n    cards.forEach(card => {\n      const nodeId = (card.getAttribute('data-node-id') || '').toLowerCase();\n      const t = detectNodeType(nodeId);\n      card.classList.add('gw-node', `gw-node--${t}`);\n\n      let ico = card.querySelector('.gw-node-ico');\n      if (!ico) {\n        ico = document.createElement('span');\n        ico.className = 'gw-node-ico';\n        (card.querySelector('.card__head') || card).prepend(ico);\n      }\n    });\n\n    const ids = [];\n    cards.forEach(card => {\n      const nodeId = (card.getAttribute('data-node-id') || '').toLowerCase();\n      const itemId = HOME_NODE_ITEM_MAP[nodeId];\n      if (itemId) ids.push(itemId);\n    });\n\n    let iconsById = {};\n    try { iconsById = await fetchItemIcons(ids); } catch(e){}\n\n    cards.forEach(card => {\n      const nodeId = (card.getAttribute('data-node-id') || '').toLowerCase();\n      const ico = card.querySelector('.gw-node-ico');\n      if (!ico) return;\n      ico.innerHTML = '';\n\n      const itemId = HOME_NODE_ITEM_MAP[nodeId];\n      const meta = itemId ? iconsById[itemId] : null;\n\n      if (meta && meta.icon){\n        const img = document.createElement('img');\n        img.loading = 'lazy';\n        img.decoding = 'async';\n        img.referrerPolicy = 'no-referrer';\n        img.src = meta.icon;\n        img.alt = meta.name || '';\n        ico.removeAttribute('data-fallback');\n        ico.appendChild(img);\n      } else {\n        const t = detectNodeType(nodeId);\n        ico.setAttribute('data-fallback','1');\n        ico.textContent = (t==='mining' ? '⛏' : (t==='logging' ? '🪓' : '✂'));\n      }\n    });\n  }\n\n  function ensureHomeNodesSection(){\n    const panel = document.getElementById('activitiesPanel');\n    if (!panel || panel.hasAttribute('hidden')) return;\n\n    let grid = panel.querySelector('#homeNodesGrid');\n    if (!grid) {\n      const body = panel.querySelector('.panel__body') || panel;\n      const title = document.createElement('h3');\n      title.className = 'panel-head__title';\n      title.style.margin = '6px 0 10px';\n      title.textContent = 'Home nodes';\n\n      grid = document.createElement('div');\n      grid.id = 'homeNodesGrid';\n      grid.className = 'grid';\n      grid.innerHTML = `\n        <label class=\"card\" data-node-id=\"orichalcum_ore_node\">\n          <div class=\"card__head\"><h4 class=\"card__title\">Orichalcum Mining Node</h4></div>\n          <p class=\"card__desc\">Recolectable diario • 3 strikes</p>\n          <div class=\"card__meta\"><span class=\"cats\">Home Instance</span></div>\n        </label>\n        <label class=\"card\" data-node-id=\"mithril_ore_node\">\n          <div class=\"card__head\"><h4 class=\"card__title\">Mithril Mining Node</h4></div>\n          <p class=\"card__desc\">Recolectable diario</p>\n          <div class=\"card__meta\"><span class=\"cats\">Home Instance</span></div>\n        </label>\n        <label class=\"card\" data-node-id=\"ancient_wood_node\">\n          <div class=\"card__head\"><h4 class=\"card__title\">Ancient Wood Logging Node</h4></div>\n          <p class=\"card__desc\">Recolectable diario</p>\n          <div class=\"card__meta\"><span class=\"cats\">Home Instance</span></div>\n        </label>\n        <label class=\"card\" data-node-id=\"quartz_node\">\n          <div class=\"card__head\"><h4 class=\"card__title\">Quartz Crystal Formation</h4></div>\n          <p class=\"card__desc\">Recolectable diario</p>\n          <div class=\"card__meta\"><span class=\"cats\">Home Instance</span></div>\n        </label>\n        <label class=\"card\" data-node-id=\"flaxseed_node\">\n          <div class=\"card__head\"><h4 class=\"card__title\">Flaxseed Harvesting Node</h4></div>\n          <p class=\"card__desc\">Recolectable diario</p>\n          <div class=\"card__meta\"><span class=\"cats\">Home Instance</span></div>\n        </label>\n        <label class=\"card\" data-node-id=\"omnomberry_node\">\n          <div class=\"card__head\"><h4 class=\"card__title\">Omnomberry Harvesting Node</h4></div>\n          <p class=\"card__desc\">Recolectable diario</p>\n          <div class=\"card__meta\"><span class=\"cats\">Home Instance</span></div>\n        </label>\n      `;\n      body.appendChild(document.createElement('hr')).className = 'hr-hairline';\n      body.appendChild(title);\n      body.appendChild(grid);\n    }\n\n    applyHomeNodePresets(grid);\n  }\n\n  document.addEventListener('DOMContentLoaded', ensureHomeNodesSection);\n\n  const panel = document.getElementById('activitiesPanel');\n  if (panel && 'MutationObserver' in window){\n    const mo = new MutationObserver(() => {\n      if (!panel.hasAttribute('hidden')) ensureHomeNodesSection();\n    });\n    mo.observe(panel, { childList:true, subtree:true, attributes:true, attributeFilter:['hidden'] });\n  }\n})();\n</script>\n",
     "text": ""
    }
   ]
  },
